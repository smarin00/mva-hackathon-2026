/*
 * MVA Hackathon 2026 — configuration
 * Target: Hetzner CPX62 (16 vCPU, 32 GB RAM, 600 GB NVMe), Nextflow 26.04 strict syntax.
 * Real paths and HPO IDs go in params.yaml (gitignored), not here.
 */

manifest {
    name            = 'mva-hackathon-2026'
    description     = 'Singleton WGS analysis for the Rare Disease, Real Kid MVA Hackathon 2026'
    nextflowVersion = '>=26.04.0'
    version         = '0.2.0'
}

// ---------------------------------------------------------------------------
// Parameters (defaults; override in params.yaml)
// ---------------------------------------------------------------------------

params {
    mode       = 'full'                         // 'full' (FASTQ) | 'vcf' (vendor VCF only)
    sample_id  = 'proband'
    outdir     = 'results'

    // inputs
    fastq_dir  = 'data'
    vendor_vcf = 'derived/vendor.chr.vcf.gz'    // chr-renamed copy of the provided VCF
    hpo_ids    = ''                             // e.g. 'HP:0000001,HP:0000002'
    panel_bed  = ''                             // MVA / spindle-checkpoint candidate panel (chr names)
    curation   = ''                             // gene-level submission curation (case-specific TSV)
    gene_diseases = ''                          // HPO genes_to_disease.txt (passed by the Makefile)
    min_gene_score = 0.1                        // min Exomiser gene score for primary rows

    // reference
    fasta      = '/opt/refs/GRCh38.fa'          // bwa index shares this prefix

    // VEP 116
    vep_sif           = '/opt/containers/vep_116.sif'
    vep_cache         = '/opt/refs/vep'
    vep_cache_version = 116
    vep_plugins_dir   = ''
    spliceai_snv      = ''
    spliceai_indel    = ''
    alphamissense     = ''
    clinvar           = ''                          // chr-renamed NCBI ClinVar VCF

    // Exomiser 15.1.0 (native)
    exomiser_dir = '/opt/refs/exomiser/exomiser-cli-15.1.0'
    exomiser_jar = 'exomiser-cli-15.1.0.jar'
    exomiser_xmx = 22

    // DeepVariant
    deepvariant_version = '1.10.0'

    // other resources
    str_catalog = ''
    bin_size    = 100000

    // read by the Makefile, not by the pipeline (see params.example.yaml)
    dataset       = ''
    panel_genes   = ''
    track2    = [gene: 'auto', variants: 'auto']
    related_genes = 'auto'
    mva_genes     = []

    // module switches
    run_vep       = true
    run_mosaic    = true
    run_sv        = true
    run_str       = true
    run_cnv       = true     // ANEUPLOIDY: depth + BAF mosaic profiling
}

// ---------------------------------------------------------------------------
// Executor: one CPX62. Memory is the binding constraint, so every label
// declares honest memory and the executor never overcommits the box.
// ---------------------------------------------------------------------------

executor {
    name   = 'local'
    cpus   = 16
    memory = 30.GB
}

process {
    // ---- Error handling ---------------------------------------------------
    // Two tiers. Do NOT pass -process.errorStrategy on the command line: it
    // overrides every selector below and erases the distinction.
    //
    // VITAL (default): retry once if killed for memory (137 = SIGKILL/OOM,
    // 139/140/143 = segfault/timeout/SIGTERM), otherwise 'finish' -- stop
    // submitting new work but let running tasks complete, so they are cached
    // for -resume and a late failure doesn't throw away hours of DeepVariant.
    errorStrategy = { task.exitStatus in [137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    // OPTIONAL: supporting evidence. A failure is reported as a NOTE and
    // recorded in trace.tsv, but nothing downstream of the submission depends
    // on these, so the run continues.
    //   DELLY / EXPANSIONHUNTER  SV and STR screens
    //   MUTECT2_PANEL            mosaic calling (panel)
    //   WHATSHAP_PANEL           phasing (panel)
    //   VEP                      extra annotation; Exomiser does the ranking
    //   ALIGN_QC / MULTIQC       reporting
    //   VERSIONS                 provenance table
    //
    // Deliberately VITAL despite looking optional:
    //   MOSDEPTH, ANEUPLOIDY     the read-level aneuploidy figure is the main
    //                            thing the full run adds over the VCF baseline
    //   MAKE_SUBMISSION          exits 1 on a validation failure; that must
    //                            stop the run, never be ignored
    withName: 'DELLY|EXPANSIONHUNTER|MUTECT2_PANEL|WHATSHAP_PANEL|VEP|ALIGN_QC|MULTIQC|VERSIONS' {
        errorStrategy = 'ignore'
    }

    // ---- Resources --------------------------------------------------------
    withLabel: 'low' {
        cpus   = 2
        memory = 4.GB
    }
    withLabel: 'medium' {
        cpus   = 8
        memory = 12.GB
    }
    withLabel: 'high' {
        cpus   = 16
        memory = 24.GB
    }
    withLabel: 'sv' {
        cpus   = 2
        memory = 8.GB
    }
    // Takes almost all RAM so nothing heavy runs alongside it.
    withLabel: 'exomiser' {
        cpus   = 4
        memory = 28.GB
    }

    // ---- Containerised tools; everything else runs natively on the host ----
    // DeepVariant memory scales with shard count, not with the memory directive:
    // each make_examples shard holds its own read buffer. So a retry with the
    // same settings would OOM again. If attempt 1 is killed, attempt 2 drops to
    // 6 shards -- slower, but it fits. 24 GB is the ceiling on a 30 GB box.
    withName: 'DEEPVARIANT' {
        container = '/opt/containers/deepvariant_1.10.0.sif'
        cpus      = { task.attempt == 1 ? 10 : 6 }
        memory    = 24.GB
    }
    withName: 'MUTECT2_PANEL' {
        container = '/opt/containers/gatk_4.7.0.0.sif'
    }
    withName: 'VEP' {
        container = '/opt/containers/vep_116.sif'
        cpus      = 8
        memory    = 16.GB
    }
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = '/opt/containers'
    runOptions = '--bind /opt/refs'
}

// Work directory inside the project (listed in DELETION.md).
workDir = 'work'

// ---------------------------------------------------------------------------
// Run reports: evidence for the methods section
// ---------------------------------------------------------------------------

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
}
